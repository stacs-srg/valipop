# Small population without recovery

group_name = test
deterministic = true
seed = 12345

initialisation_start = 1687-01-01
simulation_start = 1855-01-01
simulation_end = 1973-01-02
target_initial_population_size = 10000

initialisation_birth_rate = 0.03
initialisation_death_rate = 0.03

recovery_factor = 0
proportional_recovery_factor = 0

record_export = true
population_export = false
contingency_table_export = false
validation_export = false

record_export_format = TD

results_save_location = !TEMP!
input_distributions_path = src/test/resources/valipop/distributions

# Expected properties for test

normalize_names = true
hash_algorithm_name = MD5

expected_birth_records_hash = iNL0tgfkNH9iF2xRODYGvg==
expected_death_records_hash = HGFeiNnBAmTDlyeJozgRmQ==
expected_marriage_records_hash = iDIVDEv5RvUIaKLz9uB9Og==

expected_birth_records_count = 40577
