# Medium population

group_name = test
deterministic = true
seed = 23

initialisation_start = 1600-01-01
simulation_start = 1850-01-01
simulation_end = 2025-01-01
target_initial_population_size = 100000

initialisation_birth_rate = 0.0133
initialisation_death_rate = 0.0153

min_birth_spacing = P147D
min_gestation_period = P147D
distribution_granularity = P10Y

recovery_factor = 0.5
proportional_recovery_factor = 0.5
binomial_sampling = true

simulation_time_step = P1Y
over_sized_geography_factor = 1

record_export = true
population_export = false
contingency_table_export = false

record_export_format = TD

results_save_location = !TEMP!
input_distributions_path = src/test/resources/valipop/distributions

# Expected properties for test

normalize_names = true
hash_algorithm_name = MD5

expected_birth_records_hash = 4EW+ZOIjc6DgIFuXP7cUNQ==
expected_death_records_hash = kLQchVi9FXkyEkl6pcQnDg==
expected_marriage_records_hash = WdK/WiHY/PWoNEwXgrIP2Q==

expected_birth_records_count = 351421
expected_death_records_count = 351421
