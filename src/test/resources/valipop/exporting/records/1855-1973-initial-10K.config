# Small population with recovery

group_name = test
deterministic = true
seed = 123

initialisation_start = 1687-01-01
simulation_start = 1855-01-01
simulation_end = 1973-01-01
target_initial_population_size = 10000

initialisation_birth_rate = 0.03
initialisation_death_rate = 0.03

min_birth_spacing = P147D
min_gestation_period = P147D
distribution_granularity = P10Y

recovery_factor = 1
proportional_recovery_factor = 1
binomial_sampling = true

simulation_time_step = P1Y
over_sized_geography_factor = 1

record_export = true
population_export = false
contingency_table_export = false

record_export_format = TD

results_save_location = !TEMP!
input_distributions_path = src/test/resources/valipop/distributions

# Expected properties for test

hash_algorithm_name = MD5

expected_birth_records_hash = 91yjou8YXWveW+Iskg7F0Q==
expected_death_records_hash = fjORTPnyOV8uGZZzeeRSIw==
expected_marriage_records_hash = Isyy7AsaywWFpPXi3WzTsg==

expected_birth_records_count = 48099
expected_death_records_count = 48099
expected_marriage_records_count = 11577
